# Connexion à agent_db (remplacée par docker-compose.yml dans Docker)
DATABASE_URL=postgresql://agent:agent@localhost:5434/agent_db
# Clé publique d'auth-service et adresse de business-service (remplacées par docker-compose.yml dans Docker)
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
BUSINESS_SERVICE_URL=http://localhost:3002
# Clé de l'API Mistral (https://console.mistral.ai). Secret : jamais commitée.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai
