# Connexion à auth_db (remplacée par docker-compose.yml dans Docker)
DATABASE_URL=postgresql://auth:auth@localhost:5432/auth_db
# Clé privée RSA (PEM PKCS#8) qui signe les JWT. Générée par `pnpm env:init`. Secret : jamais commitée.
JWT_PRIVATE_KEY=
# Rotation : clé publique (PEM) de l'ancienne paire, gardée dans le JWKS 15 minutes après le changement.
JWT_PREVIOUS_PUBLIC_KEY=
# Mot de passe des 4 comptes de démonstration, créés au premier démarrage. Vide = aucun compte créé (prod).
SEED_PASSWORD=hub-demo-2026
# true derrière HTTPS : ajoute l'attribut Secure aux cookies
COOKIE_SECURE=false
